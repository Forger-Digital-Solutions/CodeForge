{
  "name": "codeforge",
  "version": "0.3.0",
  "private": true,
  "description": "CodeForge — free-first autonomous software engineering agent for Windows, CLI, and editors.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "oxlint --deny-warnings --ignore-pattern tests/evidence/** packages apps tests scripts",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "npm run clean --workspaces --if-present",
    "postinstall": "patch-package",
    "forge": "node packages/cli/dist/index.js",
    "cloud:dev": "node apps/cloud-api/dist/index.js",
    "cloud:build": "npm run build --workspace=codeforge-cloud-api",
    "verify:opencode": "node scripts/verify-opencode.mjs",
    "cloud:staging:preflight": "node scripts/cloud/staging-preflight.mjs",
    "cloud:pg:validate": "node scripts/cloud/pg-validate.mjs",
    "cloud:remote:probe": "node scripts/cloud/remote-probe.mjs",
    "cloud:certify:staging": "node scripts/cloud/certify-staging.mjs",
    "cloud:launch:checklist": "node scripts/cloud/launch-checklist.mjs",
    "repo-intelligence:certify": "node scripts/repository-intelligence-certify.mjs",
    "forgegreen:fg8:benchmark": "node scripts/forgegreen-fg8-benchmark.mjs",
    "forgegreen:r0:baseline": "node scripts/forgegreen-r0-baseline.mjs",
    "repo-intelligence:ab": "node scripts/repository-intelligence-ab.mjs",
    "legal:normalize-licenses": "node scripts/legal/normalize-package-licenses.mjs",
    "legal:notices": "node scripts/legal/generate-third-party-notices.mjs",
    "audit:legal-release": "node scripts/legal/audit-legal-release.mjs",
    "r4:scale": "node scripts/r4-scale-sim.mjs",
    "r8:benchmark": "node scripts/r8-codeforge-bench.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "app-builder-bin": "^5.0.0-alpha.10",
    "oxlint": "1.83.0",
    "patch-package": "^8.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "zod": "^3.24.0"
  },
  "allowScripts": {
    "electron@44.4.1": true,
    "better-sqlite3@12.11.1": true
  }
}
