{
  "$ref": "#/definitions/R23TaskRecord",
  "definitions": {
    "R23TaskRecord": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "class": {
          "type": "string",
          "enum": [
            "small_fix",
            "bug_fix",
            "feature",
            "refactor",
            "build_config_dependency",
            "investigation",
            "large_context"
          ]
        },
        "language": {
          "type": "string"
        },
        "repoSizeClass": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "goal": {
          "type": "string",
          "minLength": 10
        },
        "role": {
          "type": "string",
          "enum": [
            "coder",
            "explorer"
          ],
          "default": "coder"
        },
        "permissions": {
          "type": "object",
          "properties": {
            "read": {
              "type": "boolean",
              "default": true
            },
            "search": {
              "type": "boolean",
              "default": true
            },
            "write": {
              "type": "boolean"
            },
            "executeCommand": {
              "type": "boolean",
              "default": false
            },
            "network": {
              "type": "boolean",
              "const": false,
              "default": false
            }
          },
          "required": [
            "write"
          ],
          "additionalProperties": false
        },
        "fixture": {
          "type": "string",
          "default": "fixture"
        },
        "hidden": {
          "type": "string",
          "default": "hidden"
        },
        "visibleVerification": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "verifier": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string"
            },
            "timeoutMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 120000
            }
          },
          "required": [
            "command"
          ],
          "additionalProperties": false
        },
        "answerKey": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "all_substrings",
                "regex"
              ]
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "caseInsensitive": {
              "type": "boolean",
              "default": true
            }
          },
          "required": [
            "mode",
            "values"
          ],
          "additionalProperties": false
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "maxModelTurns": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 25
        }
      },
      "required": [
        "taskId",
        "class",
        "language",
        "repoSizeClass",
        "goal",
        "permissions",
        "verifier"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
