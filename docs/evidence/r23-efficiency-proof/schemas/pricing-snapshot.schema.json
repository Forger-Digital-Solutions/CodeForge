{
  "$ref": "#/definitions/R23PricingSnapshot",
  "definitions": {
    "R23PricingSnapshot": {
      "type": "object",
      "properties": {
        "snapshotId": {
          "type": "string"
        },
        "frozenAt": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "const": "USD"
        },
        "equivalents": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "priceRef": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              }
            },
            "required": [
              "priceRef",
              "rationale"
            ],
            "additionalProperties": false
          }
        },
        "marketReference": {
          "type": "object",
          "properties": {
            "priceRef": {
              "type": "string"
            },
            "rationale": {
              "type": "string"
            }
          },
          "required": [
            "priceRef",
            "rationale"
          ],
          "additionalProperties": false
        },
        "prices": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "displayName": {
                "type": "string"
              },
              "inputPerMillionUsd": {
                "type": "number",
                "minimum": 0
              },
              "outputPerMillionUsd": {
                "type": "number",
                "minimum": 0
              },
              "cacheReadPerMillionUsd": {
                "type": "number",
                "minimum": 0
              },
              "reasoningPerMillionUsd": {
                "type": "number",
                "minimum": 0
              },
              "source": {
                "type": "string"
              },
              "retrievedAt": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "inputPerMillionUsd",
              "outputPerMillionUsd",
              "source",
              "retrievedAt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "snapshotId",
        "frozenAt",
        "currency",
        "equivalents",
        "marketReference",
        "prices"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
