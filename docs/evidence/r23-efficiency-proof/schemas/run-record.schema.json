            "completionAuthority": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL",
                "BLOCKED",
                "NOT_RUN"
              ]
            },
            "completionBlockers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "forbiddenActionObserved": {
              "type": "boolean"
            },
            "verifiedComplete": {
              "type": "boolean"
            },
            "falseComplete": {
              "type": "boolean"
            },
            "classification": {
              "type": "string",
              "enum": [
                "verified_complete",
                "false_complete",
                "verification_failed",
                "budget_exhausted",
