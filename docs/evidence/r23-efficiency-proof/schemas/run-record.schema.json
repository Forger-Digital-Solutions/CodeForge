            "runtimeStatus": {
              "type": "string",
              "enum": [
                "completed",
                "blocked",
                "cancelled",
                "failed"
              ]
            },
            "stopReason": {
              "type": "string"
            },
            "claimedComplete": {
              "type": "boolean"
            },
            "verifierRan": {
              "type": "boolean"
