                "qualification",
                "pilot",
                "main",
                "variance",
                "ablation",
                "replication",
                "public_benchmark",
                "chaos",
                "fixture"
              ]
            },
            "runId": {
              "type": "string"
            },
            "pairId": {
              "type": "string"
            },
            "taskId": {
              "type": "string"
            },
            "taskClass": {
              "type": "string"
            },
            "taskLanguage": {
              "type": "string"
            },
            "repoSizeClass": {
              "type": "string",
              "enum": [
                "small",
                "medium",
                "large"
              ]
            },
            "arm": {
              "type": "string",
              "enum": [
                "control",
                "optimized"
              ]
