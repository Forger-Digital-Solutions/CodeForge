            "codeforgeCommit": {
              "type": "string"
            },
            "codeforgeTreeDirty": {
              "type": "boolean"
            },
            "dirtyFiles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "startingTreeHash": {
              "type": "string"
            },
            "endingTreeHash": {
              "type": "string"
            },
            "taskDigest": {
              "type": "string"
            },
            "modelId": {
              "type": "string"
            },
            "providerId": {
              "type": "string"
            },
            "routeClass": {
              "type": "string"
            },
            "forgeGreenEnabled": {
              "type": "boolean"
            },
            "subagentsEnabled": {
              "type": "boolean"
            },
            "topology": {
              "type": "string"
            },
            "environmentFingerprint": {
              "type": "string"
