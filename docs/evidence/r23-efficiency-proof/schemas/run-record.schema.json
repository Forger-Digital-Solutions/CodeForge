            "callsWithProviderUsage": {
              "type": "integer",
              "minimum": 0
            },
            "failedModelCalls": {
              "type": "integer",
              "minimum": 0
            },
            "retriedModelCalls": {
              "type": "integer",
              "minimum": 0
            },
            "rateLimitedCalls": {
              "type": "integer",
              "minimum": 0
            },
            "providerFailovers": {
              "type": "integer",
              "minimum": 0
            },
            "modelFailovers": {
