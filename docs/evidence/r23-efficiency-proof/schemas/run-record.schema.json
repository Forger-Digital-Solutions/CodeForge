                "required": [
                  "callIndex",
                  "providerId",
                  "requestedModelId",
                  "startedAt",
                  "endedAt",
                  "latencyMs",
                  "requestBytes",
                  "responseBytes",
                  "messageCount",
                  "messageCountByRole",
                  "toolDefinitionCount",
                  "usageSource",
                  "toolCallsEmitted",
                  "outcome",
                  "rateLimited",
