                  "completionTokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "totalTokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cachedPromptTokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cacheWriteTokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "reasoningTokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "providerReportedCostUsd": {
                    "type": "number",
                    "minimum": 0
