                  "finishReason": {
                    "type": "string",
                    "enum": [
                      "stop",
                      "tool_calls",
                      "length",
                      "content_filter",
                      "error"
                    ]
                  },
                  "toolCallsEmitted": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "ok",
                      "error",
                      "aborted"
                    ]
                  },
                  "errorCode": {
                    "type": "string"
                  },
                  "httpStatus": {
                    "type": "integer"
