            "benchmarkVersion",
            "protocolId",
            "protocolVersion",
            "protocolDigest",
            "harnessVersion",
            "campaignId",
            "phase",
            "runId",
            "pairId",
            "taskId",
            "taskClass",
            "taskLanguage",
            "repoSizeClass",
            "arm",
            "armConfigurationDigest",
            "pairOrder",
            "repetition",
            "codeforgeCommit",
            "codeforgeTreeDirty",
            "startingTreeHash",
            "endingTreeHash",
            "taskDigest",
            "modelId",
            "providerId",
            "routeClass",
            "forgeGreenEnabled",
            "subagentsEnabled",
            "topology",
            "environmentFingerprint",
            "startedAt",
            "endedAt"
