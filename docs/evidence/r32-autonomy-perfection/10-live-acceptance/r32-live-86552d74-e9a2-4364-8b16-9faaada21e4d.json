        "beforeBytes": 208,
        "afterBytes": 253,
        "afterContent": "import { echo } from \"./echo.ts\";\nimport { stats } from \"./stats.ts\";\nimport { version } from \"./version.ts\";\n\nexport type Command = (args: string[]) => Promise<number>;\n\nexport const commands: Record<string, Command> = {\n  echo,\n  stats,\n  version,\n};\n"
      },
      {
        "path": "src/commands/stats.ts",
        "beforeSha256": null,
        "afterSha256": "caf90d5f7ca1a3ffb4471cad77b090181e924564d25b6a14577f207763ad3447",
        "beforeBytes": null,
        "afterBytes": 840,
        "afterContent": "import type { Command } from \"./index.ts\";\nimport { readFile, stat } from \"fs/promises\";\n\nexport const stats: Command = async (args) => {\n  if (args.length !== 1) {\n    console.error(\"Usage: stats <file>\");\n    return 2;\n  }\n  const filepath = args[0];\n  try {\n    const [buffer, { size }] = await Promise.all([\n      readFile(filepath, { encoding: \"utf8\" }),\n      stat(filepath),\n    ]);\n    const lines = (buffer.match(/\\n/g) || []).length;\n    const words = buffer.trim() === \"\" ? 0 : buffer.trim().split(/\\s+/).length;\n    const bytes = size;\n    console.log(JSON.stringify({ lines, words, bytes }));\n    return 0;\n  } catch (err) {\n    if (err.code === \"ENOENT\") {\n      console.error(`stats: ${filepath}: No such file or directory`);\n      return 2;\n    }\n    console.error(`stats: ${filepath}: ${err.message}`);\n    return 2;\n  }\n};"
      }
    ],
