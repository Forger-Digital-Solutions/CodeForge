        "path": "src/net/retry-executor.ts",
        "beforeSha256": "65a7223db3796684d769787bede8558e1684cdedff4094c172761f50828e55e7",
        "afterSha256": "747db5a5ba0f658fa094aaaceb3ac9b4a0e78c0db05db4e8857a7c01cb8703c8",
        "beforeBytes": 341,
        "afterBytes": 341,
        "afterContent": "import type { ServiceConfig } from \"../config/types.ts\";\n\nexport async function withRetries<T>(config: ServiceConfig, operation: () => Promise<T>): Promise<T> {\n  let attempt = 0;\n  for (;;) {\n    try {\n      return await operation();\n    } catch (error) {\n      attempt += 1;\n      if (attempt > config.retryLimit) throw error;\n    }\n  }\n}\n"
      },
      {
        "path": "src/ops/cli-flags.ts",
        "beforeSha256": "e019358cfb6e5f739b90b36236fb12bb89e05adeb22461d6f133263e48d75084",
        "afterSha256": "1c74df2055da0c01cd0a3f8248b5f45cda1640e717adac11cd3dedf4fcdb61aa",
        "beforeBytes": 414,
        "afterBytes": 414,
        "afterContent": "import type { ServiceConfig } from \"../config/types.ts\";\n\nexport function parseFlags(argv: string[]): Partial<ServiceConfig> {\n  const out: Partial<ServiceConfig> = {};\n  for (const arg of argv) {\n    if (arg.startsWith(\"--max-retries=\")) out.retryLimit = Number(arg.slice(\"--max-retries=\".length));\n    if (arg.startsWith(\"--timeout=\")) out.timeoutMs = Number(arg.slice(\"--timeout=\".length));\n  }\n  return out;\n}\n"
      }
