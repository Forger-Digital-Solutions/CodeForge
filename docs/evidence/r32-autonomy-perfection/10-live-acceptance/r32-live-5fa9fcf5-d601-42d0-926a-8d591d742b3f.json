        "beforeBytes": 237,
        "afterBytes": 574,
        "afterContent": "\"\"\"Configuration layering.\"\"\"\n\n\ndef merge_config(base, override):\n    \"\"\"Return base with override applied (override wins).\"\"\"\n    result = {}\n    for key, value in base.items():\n        if key in override:\n            if isinstance(value, dict) and isinstance(override[key], dict):\n                result[key] = merge_config(value, override[key])\n            else:\n                result[key] = override[key]\n        else:\n            result[key] = value\n    for key, value in override.items():\n        if key not in base:\n            result[key] = value\n    return result\n"
      }
    ],
