        "afterContent": "import type { OrderInput } from \"../types.ts\";\n\nexport function validateOrder(input: OrderInput): string[] {\n  const errors: string[] = [];\n  if (!input.customerId || input.customerId.trim() === \"\") errors.push(\"customerId is required\");\n  if (!Array.isArray(input.lines) || input.lines.length === 0) errors.push(\"at least one line is required\");\n  for (const [index, line] of (input.lines ?? []).entries()) {\n    if (!line.sku) errors.push(`lines[${index}].sku is required`);\n    if (!Number.isInteger(line.quantity) || line.quantity <= 0) errors.push(`lines[${index}].quantity must be a positive integer`);\n  }\n  if (input.currency !== undefined && !/^[A-Z]{3}$/.test(input.currency)) errors.push(\"currency must be a 3-letter code\");\n  return errors;\n}"
