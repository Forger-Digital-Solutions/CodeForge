--- a/src/router.mjs
+++ b/src/router.mjs
@@ -1,4 +1,10 @@
 export function selectRoute(routes, request) {
-  if (request.mode === 'exact') return routes.find((route) => route.free) ?? routes[0];
-  return routes[0];
+  if (request.mode === 'exact') {
+    const exactRoute = routes.find((route) => route.id === request.id);
+    return exactRoute ?? null;
+  }
+  if (request.mode === 'free-auto') {
+    return routes.find((route) => route.free) ?? null;
+  }
+  return null;
 }
