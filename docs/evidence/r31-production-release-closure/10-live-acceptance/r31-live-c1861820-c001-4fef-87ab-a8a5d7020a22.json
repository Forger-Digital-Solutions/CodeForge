        "beforeBytes": 184,
        "afterBytes": 184,
        "afterContent": "import type { ServiceConfig } from \"./types.ts\";\n\nexport const DEFAULT_CONFIG: ServiceConfig = {\n  name: \"fleet-control\",\n  retryLimit: 3,\n  timeoutMs: 5000,\n  region: \"us-east-1\",\n};\n"
