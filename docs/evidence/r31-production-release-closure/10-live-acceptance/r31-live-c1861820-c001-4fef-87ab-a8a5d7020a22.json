        "beforeSha256": "17005a088585d431c31e1fb12bbb49a508a6192140e9984ab5581ca346cda8da",
        "afterSha256": "29e27195af99bcb10b7ad30e6792b2013cc812b1ab6851f107fa52c2d3ac7b76",
        "beforeBytes": 462,
        "afterBytes": 462,
        "afterContent": "import { DEFAULT_CONFIG } from \"./defaults.ts\";\nimport type { ServiceConfig } from \"./types.ts\";\n\nexport function loadConfig(overrides: Partial<ServiceConfig> = {}): ServiceConfig {\n  const merged = { ...DEFAULT_CONFIG, ...overrides };\n  if (!Number.isInteger(merged.retryLimit) || merged.retryLimit < 0) throw new Error(\"retryLimit must be a non-negative integer\");\n  if (merged.timeoutMs <= 0) throw new Error(\"timeoutMs must be positive\");\n  return merged;\n}\n"
      },
      {
        "path": "src/config/types.ts",
        "beforeSha256": "fa67c263efc5f8376c1479d64adb2babc0bbf31b252282bed9a410bc700919f6",
        "afterSha256": "ac43725dfab212c2c922ee8dbb9c97a5afd698b4d6bd10737e6d6a21ea5b666c",
        "beforeBytes": 112,
        "afterBytes": 112,
        "afterContent": "export interface ServiceConfig {\n  name: string;\n  retryLimit: number;\n  timeoutMs: number;\n  region: string;\n}\n"
      },
      {
        "path": "src/net/attempt-budget.ts",
        "beforeSha256": "4b475293d722cec5c6123cc6c5e668f069e1f54c5c03090f39cf5b8179de7f61",
        "afterSha256": "812720f90f543a6bd49c4125c7ad72926244a73a467ac45085f79466cf6bd604",
        "beforeBytes": 202,
        "afterBytes": 202,
        "afterContent": "import type { ServiceConfig } from \"../config/types.ts\";\n\n/** Total attempts = initial try + retries. */\nexport function attemptBudget(config: ServiceConfig): number {\n  return 1 + config.retryLimit;\n}\n"
      },
      {
        "path": "src/net/retry-executor.ts",
        "beforeSha256": "65a7223db3796684d769787bede8558e1684cdedff4094c172761f50828e55e7",
        "afterSha256": "747db5a5ba0f658fa094aaaceb3ac9b4a0e78c0db05db4e8857a7c01cb8703c8",
        "beforeBytes": 341,
        "afterBytes": 341,
        "afterContent": "import type { ServiceConfig } from \"../config/types.ts\";\n\nexport async function withRetries<T>(config: ServiceConfig, operation: () => Promise<T>): Promise<T> {\n  let attempt = 0;\n  for (;;) {\n    try {\n      return await operation();\n    } catch (error) {\n      attempt += 1;\n      if (attempt > config.retryLimit) throw error;\n    }\n  }\n}\n"
      },
      {
        "path": "src/ops/cli-flags.ts",
        "beforeSha256": "e019358cfb6e5f739b90b36236fb12bb89e05adeb22461d6f133263e48d75084",
        "afterSha256": "1c74df2055da0c01cd0a3f8248b5f45cda1640e717adac11cd3dedf4fcdb61aa",
        "beforeBytes": 414,
        "afterBytes": 414,
        "afterContent": "import type { ServiceConfig } from \"../config/types.ts\";\n\nexport function parseFlags(argv: string[]): Partial<ServiceConfig> {\n  const out: Partial<ServiceConfig> = {};\n  for (const arg of argv) {\n    if (arg.startsWith(\"--max-retries=\")) out.retryLimit = Number(arg.slice(\"--max-retries=\".length));\n    if (arg.startsWith(\"--timeout=\")) out.timeoutMs = Number(arg.slice(\"--timeout=\".length));\n  }\n  return out;\n}\n"
      }
