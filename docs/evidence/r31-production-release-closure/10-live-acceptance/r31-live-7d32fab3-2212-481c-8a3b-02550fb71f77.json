        "diff": "--- a/src/pricing/discounts.js\n+++ b/src/pricing/discounts.js\n-  return percent / 100;\n+  return 1 - percent / 100;"
      }
    ],
    "changedFileSnapshots": [
      {
        "path": "FIX_SUMMARY.md",
        "beforeSha256": null,
        "afterSha256": "83df7becf8d167e9979e51a10368408563a7814a5104797cc8c6a6929cde61b8",
        "beforeBytes": null,
        "afterBytes": 515,
        "afterContent": "Bugfix: Checkout totals are wrong when a percentage discount is applied.\n\nThe issue was in src/pricing/discounts.js where the discountMultiplier function returned the fraction of the discount (percent/100) instead of the fraction of the subtotal the customer pays after the discount (1 - percent/100).\n\nChanged:\n  return percent / 100;\nto:\n  return 1 - percent / 100;\n\nNow a cart with one item at 100.00 and a 10% discount code (WELCOME10) correctly returns 90.00 instead of 10.00.\n\nNo other files required changes."
      },
      {
        "path": "src/pricing/discounts.js",
        "beforeSha256": "43f3a1a8b9698d8c159802af902354fbe666d9e2955789a21cbdfe01cef1d90f",
        "afterSha256": "1b664559a074066caaefbb74edcd23aa58fe80588138374cb047afb123187c62",
        "beforeBytes": 294,
        "afterBytes": 298,
        "afterContent": "import { DISCOUNT_CODES } from \"./codes.js\";\n\n/** Fraction of the subtotal the customer pays after the code is applied. */\nexport function discountMultiplier(code) {\n  if (!code) return 1;\n  const percent = DISCOUNT_CODES[code];\n  if (percent === undefined) return 1;\n  return 1 - percent / 100;\n}\n"
      },
      {
        "path": "test_discount.js",
        "beforeSha256": null,
        "afterSha256": "6f56c91fb7bb050d501c88427c874e6f133a24a152ea69a5630012d7c4dd22ac",
        "beforeBytes": null,
        "afterBytes": 768,
        "afterContent": "import { computeTotal } from './src/checkout/total.js';\nimport { subtotal } from './src/checkout/subtotal.js';\nimport { discountMultiplier } from './src/pricing/discounts.js';\n\n// Test data\nconst cart = { items: [{ unitPrice: 100, quantity: 1 }] };\nconst discountCode = 'WELCOME10';\n\nconsole.log('Testing discount calculation...');\nconsole.log('Subtotal:', subtotal(cart.items));\nconsole.log('Discount multiplier for', discountCode, ':', discountMultiplier(discountCode));\nconsole.log('Total:', computeTotal(cart, discountCode));\n\n// Expected: 90\nconst expected = 90;\nconst actual = computeTotal(cart, discountCode);\nif (Math.abs(actual - expected) < 0.01) {\n  console.log('PASS: Total is correct');\n} else {\n  console.log('FAIL: Expected', expected, 'got', actual);\n}"
      }
    ],
