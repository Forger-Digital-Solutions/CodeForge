{
  "name": "codeforge-desktop",
  "version": "0.2.0",
  "private": true,
  "author": "CodeForge Team",
  "description": "CodeForge Desktop - AI-powered coding agent for Windows",
  "main": "./dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run build:native && electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:native": "node scripts/rebuild-native.mjs",
    "build:main": "tsc -p tsconfig.main.json && node -e \"require('fs').copyFileSync('src/preload.cjs', 'dist/preload.cjs')\"",
    "build:renderer": "vite build",
    "build:prod": "npm run dist",
    "pack": "npm run build && npm run build:native && electron-builder --dir",
    "dist": "npm run build && npm run build:native && electron-builder",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "smoke": "node scripts/packaged-smoke.js full",
    "smoke:interrupt": "node scripts/packaged-smoke.js interrupt",
    "smoke:recover": "node scripts/packaged-smoke.js recover",
    "smoke:all": "node scripts/packaged-smoke.js full && node scripts/packaged-smoke.js interrupt && node scripts/packaged-smoke.js recover",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@codeforge/ui": "*",
    "@codeforge/server": "*",
    "@codeforge/protocol": "*",
    "@codeforge/sessions": "*",
    "@codeforge/forge-zero": "*",
    "@codeforge/providers": "*",
    "better-sqlite3": "^12.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "33.4.11",
    "electron-builder": "^25.0.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "better-sqlite3@12.11.1": true
  },
  "build": {
    "appId": "app.codeforge.desktop",
    "productName": "CodeForge",
    "executableName": "CodeForge",
    "npmRebuild": false,
    "asar": {
      "smartUnpack": false
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node"
    ],
    "directories": {
      "app": "../..",
      "output": "release"
    },
    "extraMetadata": {
      "name": "codeforge-desktop",
      "version": "0.2.0",
      "type": "module",
      "main": "apps/desktop/dist/main.js",
      "author": "CodeForge Team",
      "description": "CodeForge Desktop - AI-powered coding agent for Windows"
    },
    "files": [
      "apps/desktop/dist/**/*",
      "!apps/desktop/dist/**/*.map",
      "!apps/desktop/dist/**/*.d.ts",
      "!apps/desktop/dist/preload.js",
      "!node_modules/zod/src/**/*",
      "!node_modules/better-sqlite3/build/**/*",
      "!node_modules/better-sqlite3/src/**/*",
      "!node_modules/better-sqlite3/deps/**/*",
      "!node_modules/better-sqlite3/bin/**/*",
      {
        "from": "packages",
        "to": "node_modules/@codeforge",
        "filter": [
          "agent/dist/**/*.js",
          "agent/package.json",
          "core/dist/**/*.js",
          "core/package.json",
          "director/dist/**/*.js",
          "director/package.json",
          "forge-zero/dist/**/*.js",
          "forge-zero/package.json",
          "model-registry/dist/**/*.js",
          "model-registry/package.json",
          "permissions/dist/**/*.js",
          "permissions/package.json",
          "protocol/dist/**/*.js",
          "protocol/package.json",
          "providers/dist/**/*.js",
          "providers/package.json",
          "router/dist/**/*.js",
          "router/package.json",
          "secrets/dist/**/*.js",
          "secrets/package.json",
          "server/dist/**/*.js",
          "server/package.json",
          "sessions/dist/**/*.js",
          "sessions/package.json",
          "tools/dist/**/*.js",
          "tools/package.json",
          "ui/dist/**/*.js",
          "ui/package.json",
          "workflow/dist/**/*.js",
          "workflow/package.json"
        ]
      },
      {
        "from": "node_modules/zod",
        "to": "node_modules/zod",
        "filter": [
          "package.json",
          "LICENSE",
          "**/*.js",
          "**/*.cjs",
          "**/*.mjs"
        ]
      },
      {
        "from": "node_modules/better-sqlite3",
        "to": "node_modules/better-sqlite3",
        "filter": [
          "package.json",
          "LICENSE",
          "lib/**/*",
          "build/Release/better_sqlite3.node"
        ]
      },
      {
        "from": "node_modules/bindings",
        "to": "node_modules/bindings",
        "filter": [
          "package.json",
          "LICENSE.md",
          "bindings.js"
        ]
      },
      {
        "from": "node_modules/file-uri-to-path",
        "to": "node_modules/file-uri-to-path",
        "filter": [
          "package.json",
          "LICENSE",
          "index.js"
        ]
      },
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "CodeForge-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CodeForge-Portable.exe"
    }
  }
}
