{
  "name": "codeforge-desktop",
  "version": "0.1.0",
  "private": true,
  "author": "CodeForge Team",
  "description": "CodeForge Desktop - AI-powered coding agent for Windows",
  "main": "./dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "npm run build:native && npm run build:main && npm run build:renderer",
    "build:native": "electron-rebuild -v 33.4.11 -f -o better-sqlite3 --build-from-source",
    "build:main": "tsc -p tsconfig.main.json && node -e \"require('fs').copyFileSync('src/preload.cjs', 'dist/preload.cjs')\"",
    "build:renderer": "vite build",
    "build:prod": "npm run build && electron-builder",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "rebuild:native": "electron-rebuild -v 33.4.11 -f -o better-sqlite3 --build-from-source",
    "smoke": "node scripts/packaged-smoke.js full",
    "smoke:interrupt": "node scripts/packaged-smoke.js interrupt",
    "smoke:recover": "node scripts/packaged-smoke.js recover",
    "smoke:all": "node scripts/packaged-smoke.js full && node scripts/packaged-smoke.js interrupt && node scripts/packaged-smoke.js recover",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@codeforge/ui": "*",
    "@codeforge/server": "*",
    "@codeforge/protocol": "*",
    "@codeforge/sessions": "*",
    "@codeforge/forge-zero": "*",
    "@codeforge/providers": "*",
    "better-sqlite3": "^12.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "33.4.11",
    "electron-builder": "^25.0.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "better-sqlite3@12.11.1": true
  },
  "build": {
    "appId": "app.codeforge.desktop",
    "productName": "CodeForge",
    "executableName": "CodeForge",
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node"
    ],
    "directories": {
      "app": "../..",
      "output": "release"
    },
    "extraMetadata": {
      "name": "codeforge-desktop",
      "version": "0.1.0",
      "type": "module",
      "main": "apps/desktop/dist/main.js",
      "author": "CodeForge Team",
      "description": "CodeForge Desktop - AI-powered coding agent for Windows"
    },
    "files": [
      "apps/desktop/dist/**/*",
      {
        "from": "packages",
        "to": "node_modules/@codeforge",
        "filter": [
          "*/dist/**/*",
          "*/package.json",
          "!*/dist/**/*.ts.map",
          "!*/dist/**/*.d.ts.map"
        ]
      },
      {
        "from": "node_modules/zod",
        "to": "node_modules/zod",
        "filter": [
          "**/*",
          "!**/*.ts.map",
          "!**/*.d.ts.map"
        ]
      },
      {
        "from": "node_modules/better-sqlite3",
        "to": "node_modules/better-sqlite3",
        "filter": [
          "package.json",
          "lib/**/*",
          "build/Release/better_sqlite3.node"
        ]
      },
      {
        "from": "node_modules/bindings",
        "to": "node_modules/bindings",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/file-uri-to-path",
        "to": "node_modules/file-uri-to-path",
        "filter": [
          "**/*"
        ]
      },
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "CodeForge-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CodeForge-Portable.exe"
    }
  }
}
