# CodeForge environment variables — copy to .env and fill in as needed.
# Node does not auto-load .env; export these in your shell/profile or your platform's secret store.
# NEVER commit real secrets. This file documents names and shapes only.

# =============================================================================
# Desktop / CLI (optional)
# =============================================================================
# CODEFORGE_REAL_RUNTIME=true              # use real AgentRuntime inference instead of demo simulation
# CODEFORGE_SQLITE_DRIVER=node:sqlite      # node:sqlite | better-sqlite3
# CODEFORGE_ALLOW_TEST_PROVIDERS=1         # allow scripted test providers outside NODE_ENV=test (dev only)
# CODEFORGE_UPGRADE_URL=https://example.com/upgrade
# ELECTRON_DEV=true                        # load renderer from Vite dev server
# CODEFORGE_SMOKE_OUT=                      # CI packaged persistence smoke output dir

# Desktop → which CodeForge Cloud to talk to. NOT a secret, but authoritative configuration.
# These are honored ONLY on a development-channel, unpackaged build. A packaged staging or
# production build takes its endpoint from apps/desktop/cloud-endpoints.json and ignores these
# variables entirely, so privileged auth/accounting traffic cannot be redirected at runtime.
# Set a release channel with:
#   npm run build:channel --workspace=codeforge-desktop -- --channel staging --url https://...
# CODEFORGE_CLOUD_URL=http://127.0.0.1:3220
# CODEFORGE_CLOUD_API_URL=http://127.0.0.1:3220 # supported compatibility alias

# =============================================================================
# CodeForge Cloud API (apps/cloud-api) — server-side only
# =============================================================================
# --- Runtime ---
# CODEFORGE_CLOUD_ENV=staging              # development | staging | production
# NODE_ENV=production
# HOST=0.0.0.0                             # bind address (0.0.0.0 in a container)
# PORT=3220
# REQUIRED in staging/production. The deployment's public HTTPS origin; GitHub redirects back to
# ${CODEFORGE_PUBLIC_URL}/v1/auth/github/callback, which is the URL to register in the OAuth App.
# CODEFORGE_PUBLIC_URL=https://staging-api.codeforge.dev

# --- Database (Postgres is the production-truth driver) ---
# CODEFORGE_CLOUD_DB_DRIVER=postgres       # sqlite | postgres
# DATABASE_URL=postgres://user:pass@host:5432/codeforge
# CODEFORGE_CLOUD_DB_SSL=true              # required for non-loopback Postgres in staging/production; validates the server certificate
# CODEFORGE_CLOUD_DB_PATH=/data/codeforge.db   # sqlite persistent path (NOT :memory: in staging/prod)

# --- Auth (required in staging/production) ---
# The GitHub OAuth App's "Authorization callback URL" must be exactly:
#     ${CODEFORGE_PUBLIC_URL}/v1/auth/github/callback
# Do NOT register a 127.0.0.1 callback: the desktop loopback is never sent to GitHub.
# JWT_SECRET=                              # >= 32 cryptographically strong chars
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=                    # server-side only; never shipped to the desktop

# --- Stripe (TEST MODE ONLY — live sk_live_/rk_live_ keys are refused at boot) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_CREDIT_PRICE_ID=price_...

# --- Server-owned provider credentials (power Hosted Free; NEVER sent to desktop clients) ---
# Only providers whose key is present are attempted. Paid-only providers (OpenAI) are never used
# for Hosted Free capacity. Pattern generally follows {PROVIDER}_API_KEY.
# OPENROUTER_API_KEY=                      # gateway: exposes $0 ":free" routes
# GROQ_API_KEY=                            # free developer allowance (verified by probe)
# GEMINI_API_KEY=                          # (or GOOGLE_API_KEY) free allowance
# ZHIPU_API_KEY=                           # (or ZAI_API_KEY) Z.AI native free glm-*-flash
# CLOUDFLARE_ACCOUNT_ID=                   # Cloudflare Workers AI needs BOTH of these
# CLOUDFLARE_API_KEY=

# --- Operator kill switches / owner-spend firewall (safe defaults shown) ---
# CODEFORGE_HOSTED_INFERENCE_ENABLED=true          # master switch for all hosted inference
# CODEFORGE_HOSTED_FREE_ENABLED=true               # switch for the Free tier specifically
# CODEFORGE_MAX_REQUEST_COST_USD=2.0               # per-request cost ceiling
# CODEFORGE_GLOBAL_DAILY_SPEND_LIMIT_USD=1000.0    # global daily provider spend cap (fail-closed)

# --- Networking / limits ---
# CODEFORGE_MAX_REQUESTS_PER_MINUTE=120
# CODEFORGE_REQUEST_TIMEOUT_MS=60000
# CODEFORGE_TRUST_PROXY=false               # set true only when the service is reachable exclusively through a trusted platform proxy
# CODEFORGE_ALLOWED_ORIGINS=https://app.codeforge.dev,https://codeforge.dev   # comma-separated
# CODEFORGE_LOG_LEVEL=info                 # debug | info | warn | error | silent
