# CodeForge optional environment variables
# Copy to .env and uncomment as needed (Node does not auto-load .env; export manually or use your shell profile).

# Use real AgentRuntime with provider inference instead of demo simulation
# CODEFORGE_REAL_RUNTIME=true

# Force SQLite driver: node:sqlite | better-sqlite3
# CODEFORGE_SQLITE_DRIVER=node:sqlite

# Allow test providers outside NODE_ENV=test (development only)
# CODEFORGE_ALLOW_TEST_PROVIDERS=1

# Override GEMS upgrade navigation URL shown for locked models
# CODEFORGE_UPGRADE_URL=https://example.com/upgrade

# Provider API keys — pattern is {PROVIDER_ID}_API_KEY (uppercase)
# OPENROUTER_API_KEY=

# Electron dev mode — load renderer from Vite dev server instead of bundled files
# ELECTRON_DEV=true

# CI packaged persistence smoke test output directory
# CODEFORGE_SMOKE_OUT=
