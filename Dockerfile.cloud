# CodeForge Cloud API — production image
# Runs the COMPILED dist (never TypeScript through dev tooling). Multi-stage, non-root, healthcheck.
#
#   docker build -f Dockerfile.cloud -t codeforge-cloud-api .
#   docker run --rm -p 3220:3220 \
#     -e NODE_ENV=production -e CODEFORGE_CLOUD_ENV=staging \
#     -e JWT_SECRET=... -e GITHUB_CLIENT_ID=... -e GITHUB_CLIENT_SECRET=... \
#     -e STRIPE_SECRET_KEY=sk_test_... -e STRIPE_WEBHOOK_SECRET=whsec_... \
#     -e CODEFORGE_CLOUD_DB_DRIVER=postgres -e DATABASE_URL=postgres://... \
#     -e OPENROUTER_API_KEY=... -e GROQ_API_KEY=... \
#     codeforge-cloud-api
#
# Secrets are provided at RUN time via env, never baked into the image.

# ============================================================================
# Stage 1: Builder — install all workspace deps and compile every package to dist/.
# ============================================================================
FROM node:22-slim AS builder

WORKDIR /app

# Toolchain for optional native deps (better-sqlite3 is optional; node:sqlite is the default driver).
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

# Install against the committed lockfile first for layer caching.
COPY package.json package-lock.json ./
COPY tsconfig.json tsconfig.base.json ./
COPY patches ./patches
COPY packages ./packages
COPY apps ./apps

# Full install (workspaces), then compile. patch-package runs via postinstall.
RUN npm ci

# `npm run build --workspaces` does not guarantee a dependency-aware order.
# Build the TypeScript project graph first, then the Cloud-only packages in
# their explicit dependency order so this remains reproducible from a clean
# image layer.
RUN npx tsc -b \
    && npm run build --workspace=@codeforge/cloud-db \
    && npm run build --workspace=@codeforge/cloud-auth \
    && npm run build --workspace=@codeforge/cloud-entitlements \
    && npm run build --workspace=@codeforge/cloud-usage \
    && npm run build --workspace=@codeforge/cloud-billing \
    && npm run build --workspace=@codeforge/cloud-gateway \
    && npm run build --workspace=codeforge-cloud-api

# Drop dev-only dependencies (electron, vite, react, typescript, …) from node_modules for the runner.
RUN npm prune --omit=dev

# ============================================================================
# Stage 2: Runner — minimal, non-root, compiled output only.
# ============================================================================
FROM node:22-slim AS runner

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3220

# Non-root runtime user.
RUN groupadd --system --gid 1001 codeforge \
    && useradd --system --uid 1001 --gid codeforge codeforge

WORKDIR /app

# Pruned production dependencies and compiled workspace output.
COPY --from=builder --chown=codeforge:codeforge /app/node_modules ./node_modules
COPY --from=builder --chown=codeforge:codeforge /app/package.json ./package.json
COPY --from=builder --chown=codeforge:codeforge /app/packages ./packages
COPY --from=builder --chown=codeforge:codeforge /app/apps/cloud-api ./apps/cloud-api

USER codeforge

EXPOSE 3220

# Liveness probe hits the always-on /health/live endpoint (no DB or provider dependency).
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3220)+'/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/cloud-api/dist/index.js"]
