{
  "name": "codeforge-vscode",
  "displayName": "CodeForge",
  "description": "Free-first autonomous software engineering agent for VS Code",
  "version": "0.1.0",
  "publisher": "codeforge",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Education"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeforge.startSession",
        "title": "CodeForge: Start Session"
      },
      {
        "command": "codeforge.sendMessage",
        "title": "CodeForge: Send Message"
      },
      {
        "command": "codeforge.openWebview",
        "title": "CodeForge: Open Webview"
      },
      {
        "command": "codeforge.stopServer",
        "title": "CodeForge: Stop Server"
      }
    ],
    "configuration": {
      "title": "CodeForge",
      "properties": {
        "codeforge.serverUrl": {
          "type": "string",
          "default": "http://localhost:3210",
          "description": "URL of the CodeForge server"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --force",
    "clean": "rm -rf dist",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "test": "node dist/test/runTest.js",
    "pretest": "npm run compile"
  },
  "dependencies": {
    "@codeforge/sdk": "*",
    "@codeforge/server": "*",
    "@codeforge/protocol": "*"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.9",
    "mocha": "^10.8.2",
    "glob": "^11.0.0",
    "@types/mocha": "^10.0.10"
  }
}
